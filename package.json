{
  "name": "sea-of-stars",
  "version": "1.0.0",
  "private": true,
  "description": "Sea of Stars — a cinematic birthday journey for Mubarra, made with love by Awais.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && node tooling/check-boundaries.mjs",
